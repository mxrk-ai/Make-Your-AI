# Copy to .env and fill in. .env is in .gitignore and is never committed.
# Nothing here is needed to run the tests or the local pipeline.

# Hugging Face token with write permission (uploading the zoo and the generator)
HF_TOKEN=

# Agent LLM providers. Set only the one you use.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
